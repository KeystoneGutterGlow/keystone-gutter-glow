# Copy to .env.local for local overrides. All optional.

# Booking storage: "memory" (default, demo data, resets on restart) or "supabase"
BOOKING_STORE=memory
# BOOKING_DEMO_SEED=off

# Needed when BOOKING_STORE=supabase. Server-side only; never prefix with NEXT_PUBLIC_.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL used for canonical/OG/schema links. Defaults to Vercel's production domain.
# SITE_URL=https://keystonegutterglow.com

# Set to "true" only on the real domain so the mockup never gets indexed.
# ALLOW_INDEXING=true
